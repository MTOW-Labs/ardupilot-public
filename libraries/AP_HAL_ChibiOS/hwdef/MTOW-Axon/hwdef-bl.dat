# bootloader hwdef for the MTOW Axon-C (STM32H743VIT6)

MCU STM32H7xx STM32H743xx

# external 24 MHz oscillator in HSE bypass mode
OSCILLATOR_HZ 24000000
define STM32_HSE_BYPASS

# USB identity (placeholder — assign real IDs before release)
USB_VENDOR 0x1209
USB_PRODUCT 0x5740
USB_STRING_MANUFACTURER "MTOW"
USB_STRING_PRODUCT "Axon-C"

# board ID (must match hwdef.dat)
APJ_BOARD_ID 5260

# bootloader at zero offset; firmware loaded at 128 KB
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128
FLASH_SIZE_KB 2048

# USB + telem1 + telem2 for bootloader comms
SERIAL_ORDER OTG1 UART7 USART3

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9  VBUS INPUT OPENDRAIN

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# sensor CS pins — tri-state sensors during bootloader
PC15 IMU1_CS CS
PC14 IMU2_CS CS
PC13 IMU3_CS CS

# TELEM1
PE8 UART7_TX UART7
PE7 UART7_RX UART7

# TELEM2 / debug
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# power on sensor domains + 5V peripheral rail
PB2  SENSOR1_EN OUTPUT HIGH
PB0  SENSOR2_EN OUTPUT HIGH
PH1  SENSOR3_EN OUTPUT HIGH
PD11 SENSOR4_EN OUTPUT HIGH
PE2  nVDD_5V_PERIPH_EN OUTPUT LOW

define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384

# microSD (bootloader flash-from-SD support)
PD6  SDMMC2_CK  SDMMC2
PD7  SDMMC2_CMD SDMMC2
PB14 SDMMC2_D0  SDMMC2
PB15 SDMMC2_D1  SDMMC2
PB3  SDMMC2_D2  SDMMC2
PB4  SDMMC2_D3  SDMMC2
define FATFS_HAL_DEVICE SDCD2

define CH_CFG_USE_MEMCORE 1
define CH_CFG_USE_HEAP 1
define CH_CFG_USE_SEMAPHORES 0
define CH_CFG_USE_MUTEXES 1
define CH_CFG_USE_DYNAMIC 1
define CH_CFG_USE_WAITEXIT 1
define CH_CFG_USE_REGISTRY 1

DMA_PRIORITY SDMMC* USART6* ADC* UART* USART* SPI* TIM*
define HAL_OS_FATFS_IO 1
define AP_BOOTLOADER_FLASH_FROM_SD_ENABLED 1
